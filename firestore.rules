rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.cidade is string
                    && request.resource.data.cidade.size() > 0
                    && request.resource.data.sobreMim is string;

      allow get: if request.auth != null
                 && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'nome',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.cidade is string
                    && request.resource.data.cidade.size() > 0
                    && request.resource.data.sobreMim is string;

      allow list, delete: if false;

    match /notificacoes/{notificacaoId} {
      allow get, list: if request.auth != null
                    && request.auth.uid == userId;

      function dadosValidos() {
        return request.resource.data.keys().hasOnly([
                 'tipo',
                 'titulo',
                 'mensagem',
                 'remetenteId',
                 'remetenteNome',
                 'destinatarioId',
                 'eventoId',
                 'publicacaoId',
                 'conversaId',
                 'doacaoId',
                 'lida',
                 'dataCriacao'
               ])
               && request.resource.data.keys().hasAll([
                 'tipo',
                 'titulo',
                 'mensagem',
                 'remetenteId',
                 'remetenteNome',
                 'destinatarioId',
                 'eventoId',
                 'publicacaoId',
                 'conversaId',
                 'doacaoId',
                 'lida',
                 'dataCriacao'
               ])
               && request.resource.data.titulo is string
               && request.resource.data.titulo.size() > 0
               && request.resource.data.titulo.size() <= 100
               && request.resource.data.mensagem is string
               && request.resource.data.mensagem.size() > 0
               && request.resource.data.mensagem.size() <= 300
               && request.resource.data.remetenteId == request.auth.uid
               && request.resource.data.remetenteNome is string
               && request.resource.data.remetenteNome.size() > 0
               && request.resource.data.destinatarioId == userId
               && request.resource.data.eventoId is string
               && request.resource.data.eventoId.size() > 0
               && request.resource.data.publicacaoId is string
               && request.resource.data.publicacaoId.size() > 0
               && (
                 request.resource.data.conversaId == null
                 || request.resource.data.conversaId is string
               )
               && (
                 request.resource.data.doacaoId == null
                 || request.resource.data.doacaoId is string
               )
               && request.resource.data.remetenteId != userId
               && request.resource.data.lida == false
               && request.resource.data.dataCriacao == request.time;
      }

      function validarNovoInteresse() {
        let publicacao = /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId);
        let interesse = /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.auth.uid);

        return request.resource.data.tipo == 'novo_interesse'
               && request.resource.data.titulo == 'Novo interesse'
               && request.resource.data.eventoId == request.auth.uid
               && request.resource.data.conversaId == null
               && request.resource.data.doacaoId == null
               && exists(publicacao)
               && get(publicacao).data.usuarioId == userId
               && get(publicacao).data.status == 'ativa'
               && existsAfter(interesse)
               && getAfter(interesse).data.usuarioId == request.auth.uid
               && getAfter(interesse).data.nomeUsuario == request.resource.data.remetenteNome
               && getAfter(interesse).data.dataCriacao == request.time;
      }

      function validarInteressadoEscolhido() {
        let publicacao = /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId);

        return request.resource.data.tipo == 'interessado_escolhido'
               && request.resource.data.titulo == 'Você foi escolhido!'
               && request.resource.data.eventoId == request.resource.data.publicacaoId
               && request.resource.data.conversaId == null
               && request.resource.data.doacaoId == null
               && exists(publicacao)
               && get(publicacao).data.usuarioId == request.auth.uid
               && get(publicacao).data.status == 'ativa'
               && get(publicacao).data.nomeDoador == request.resource.data.remetenteNome
               && getAfter(publicacao).data.status == 'em_andamento'
               && getAfter(publicacao).data.usuarioEscolhidoId == userId;
      }

      function validarDoacaoConcluida() {
        return request.resource.data.doacaoId is string
               && validarDoacaoConcluidaComId();
      }

      function validarDoacaoConcluidaComId() {
        let publicacao = /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId);
        let doacao = /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoId);

        return request.resource.data.tipo == 'doacao_concluida'
               && request.resource.data.titulo == 'Doação concluída'
               && request.resource.data.eventoId == request.resource.data.doacaoId
               && request.resource.data.conversaId == null
               && exists(publicacao)
               && get(publicacao).data.usuarioId == request.auth.uid
               && get(publicacao).data.status == 'em_andamento'
               && get(publicacao).data.usuarioEscolhidoId == userId
               && get(publicacao).data.nomeDoador == request.resource.data.remetenteNome
               && existsAfter(doacao)
               && getAfter(doacao).data.publicacaoId == request.resource.data.publicacaoId
               && getAfter(doacao).data.doadorId == request.auth.uid
               && getAfter(doacao).data.beneficiarioId == userId
               && getAfter(doacao).data.status == 'concluida'
               && getAfter(publicacao).data.status == 'concluida'
               && getAfter(publicacao).data.doacaoAtualId == request.resource.data.doacaoId;
      }

      function validarDoacaoReaberta() {
        let publicacao = /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId);

        return request.resource.data.tipo == 'doacao_reaberta'
               && request.resource.data.titulo == 'Doação reaberta'
               && request.resource.data.eventoId == request.resource.data.publicacaoId
               && request.resource.data.conversaId == null
               && exists(publicacao)
               && get(publicacao).data.usuarioId == request.auth.uid
               && get(publicacao).data.status == 'concluida'
               && get(publicacao).data.usuarioEscolhidoId == userId
               && get(publicacao).data.nomeDoador == request.resource.data.remetenteNome
               && getAfter(publicacao).data.status == 'ativa'
               && !getAfter(publicacao).data.keys().hasAny([
                 'usuarioEscolhidoId',
                 'usuarioEscolhidoNome',
                 'usuarioEscolhidoCidade',
                 'dataConclusao',
                 'doacaoAtualId'
               ])
               && (
                 request.resource.data.doacaoId == null
                 || validarHistoricoReaberto()
               );
      }

      function validarHistoricoReaberto() {
        let doacao = /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoId);

        return request.resource.data.doacaoId is string
               && exists(doacao)
               && get(doacao).data.publicacaoId == request.resource.data.publicacaoId
               && get(doacao).data.doadorId == request.auth.uid
               && get(doacao).data.beneficiarioId == userId
               && get(doacao).data.status == 'concluida'
               && getAfter(doacao).data.status == 'reaberta'
               && getAfter(doacao).data.dataReabertura == request.time;
      }

      function validarNovaMensagem() {
        return request.resource.data.conversaId is string
               && validarNovaMensagemComConversa();
      }

      function validarNovaMensagemComConversa() {
        let conversa = /databases/$(database)/documents/conversas/$(request.resource.data.conversaId);
        let mensagem = /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)/mensagens/$(request.resource.data.eventoId);

        return request.resource.data.tipo == 'nova_mensagem'
               && request.resource.data.titulo == 'Nova mensagem'
               && request.resource.data.conversaId is string
               && request.resource.data.doacaoId == null
               && exists(conversa)
               && get(conversa).data.publicacaoId == request.resource.data.publicacaoId
               && request.auth.uid in get(conversa).data.participantes
               && userId in get(conversa).data.participantes
               && (
                 (
                   get(conversa).data.doadorId == request.auth.uid
                   && get(conversa).data.interessadoId == userId
                   && get(conversa).data.doadorNome == request.resource.data.remetenteNome
                 )
                 ||
                 (
                   get(conversa).data.interessadoId == request.auth.uid
                   && get(conversa).data.doadorId == userId
                   && get(conversa).data.interessadoNome == request.resource.data.remetenteNome
                 )
               )
               && existsAfter(mensagem)
               && getAfter(mensagem).data.remetenteId == request.auth.uid
               && getAfter(mensagem).data.dataEnvio == request.time;
      }

      allow create: if request.auth != null
                    && dadosValidos()
                    && (
                      validarNovoInteresse()
                      || validarInteressadoEscolhido()
                      || validarDoacaoConcluida()
                      || validarDoacaoReaberta()
                      || validarNovaMensagem()
                    );

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.lida == false
                    && request.resource.data.lida == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'lida'
                    ]);

      allow delete: if false;
    }
  }

    match /publicacoes/{publicacaoId} {
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid
                    && exists(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    )
                    && request.resource.data.nomeDoador is string
                    && request.resource.data.nomeDoador ==
                      get(
                        /databases/$(database)/documents/usuarios/$(request.auth.uid)
                      ).data.nome
                    && request.resource.data.keys().hasOnly([
                      'usuarioId',
                      'nomeDoador',
                      'titulo',
                      'descricao',
                      'categoria',
                      'estadoConservacao',
                      'cidade',
                      'dataCriacao',
                      'status',
                      'imagens',
                      'coordenadas'
                    ])
                    && request.resource.data.keys().hasAll([
                      'usuarioId',
                      'nomeDoador',
                      'titulo',
                      'descricao',
                      'categoria',
                      'estadoConservacao',
                      'cidade',
                      'dataCriacao',
                      'status',
                      'imagens'
                    ])
                    && request.resource.data.titulo is string
                    && request.resource.data.descricao is string
                    && request.resource.data.categoria is string
                    && request.resource.data.estadoConservacao is string
                    && request.resource.data.cidade is string
                    && request.resource.data.dataCriacao is timestamp
                    && request.resource.data.status == 'ativa'
                    && request.resource.data.imagens is list
                    && request.resource.data.imagens.size() <= 3
                    && (
                      !request.resource.data.keys().hasAny(['coordenadas'])
                      || request.resource.data.coordenadas is latlng
                    );

      allow get: if request.auth != null
                    && (
                      resource.data.status == 'ativa'
                      || resource.data.usuarioId == request.auth.uid
                      || (
                        resource.data.keys().hasAny(['usuarioEscolhidoId'])
                        && resource.data.usuarioEscolhidoId == request.auth.uid
                      )
                      || exists(
                        /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.auth.uid)
                      )
                    );

      allow list: if request.auth != null
                    && (
                      resource.data.status == 'ativa'
                      || resource.data.usuarioId == request.auth.uid
                      || (
                        resource.data.keys().hasAny(['usuarioEscolhidoId'])
                        && resource.data.usuarioEscolhidoId == request.auth.uid
                      )
                    );

      allow update: if request.auth != null
                    && resource.data.usuarioId == request.auth.uid
                    && (

                      (
                        request.resource.data.usuarioId == resource.data.usuarioId
                        && request.resource.data.dataCriacao == resource.data.dataCriacao
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'titulo',
                          'descricao',
                          'categoria',
                          'estadoConservacao',
                          'cidade',
                          'imagens',
                          'coordenadas'
                        ])
                        && request.resource.data.titulo is string
                        && request.resource.data.descricao is string
                        && request.resource.data.categoria is string
                        && request.resource.data.estadoConservacao is string
                        && request.resource.data.cidade is string
                        && request.resource.data.imagens is list
                        && request.resource.data.imagens.size() <= 3
                        && (
                          !request.resource.data.keys().hasAny(['coordenadas'])
                          || request.resource.data.coordenadas is latlng
                        )
                      )

                      ||

                      (
                        resource.data.status == 'ativa'
                        && !resource.data.keys().hasAny([
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade'
                        ])
                        && request.resource.data.status == 'em_andamento'
                        && request.resource.data.usuarioEscolhidoId is string
                        && request.resource.data.usuarioEscolhidoId != request.auth.uid
                        && request.resource.data.usuarioEscolhidoNome is string
                        && request.resource.data.usuarioEscolhidoNome.size() > 0
                        && request.resource.data.usuarioEscolhidoCidade is string
                        && request.resource.data.usuarioEscolhidoCidade.size() > 0
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade'
                        ])
                        && exists(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.resource.data.usuarioEscolhidoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.resource.data.usuarioEscolhidoId)
                        ).data.usuarioId == request.resource.data.usuarioEscolhidoId
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.resource.data.usuarioEscolhidoId)
                        ).data.nomeUsuario == request.resource.data.usuarioEscolhidoNome
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.resource.data.usuarioEscolhidoId)
                        ).data.cidade == request.resource.data.usuarioEscolhidoCidade
                      )

                      ||

                      (
                        resource.data.status == 'em_andamento'
                        && resource.data.usuarioEscolhidoId is string
                        && request.resource.data.status == 'ativa'
                        && !request.resource.data.keys().hasAny([
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade',
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade'
                        ])
                      )

                      ||

                      (
                        resource.data.status == 'em_andamento'
                        && resource.data.usuarioEscolhidoId is string
                        && resource.data.usuarioEscolhidoNome is string
                        && resource.data.usuarioEscolhidoCidade is string
                        && !resource.data.keys().hasAny([
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && request.resource.data.status == 'concluida'
                        && request.resource.data.usuarioEscolhidoId == resource.data.usuarioEscolhidoId
                        && request.resource.data.dataConclusao == request.time
                        && request.resource.data.doacaoAtualId is string
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && existsAfter(
                          /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoAtualId)
                        )
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoAtualId)
                        ).data.publicacaoId == publicacaoId
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoAtualId)
                        ).data.doadorId == request.auth.uid
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoAtualId)
                        ).data.beneficiarioId == resource.data.usuarioEscolhidoId
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoAtualId)
                        ).data.dataConclusao == request.time
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(request.resource.data.doacaoAtualId)
                        ).data.status == 'concluida'
                      )

                      ||

                      (
                        resource.data.status == 'concluida'
                        && resource.data.keys().hasAll([
                          'usuarioEscolhidoId',
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && resource.data.usuarioEscolhidoId is string
                        && resource.data.dataConclusao is timestamp
                        && resource.data.doacaoAtualId is string
                        && request.resource.data.status == 'ativa'
                        && !request.resource.data.keys().hasAny([
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade',
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade',
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && exists(
                          /databases/$(database)/documents/doacoes/$(resource.data.doacaoAtualId)
                        )
                        && get(
                          /databases/$(database)/documents/doacoes/$(resource.data.doacaoAtualId)
                        ).data.publicacaoId == publicacaoId
                        && get(
                          /databases/$(database)/documents/doacoes/$(resource.data.doacaoAtualId)
                        ).data.doadorId == request.auth.uid
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(resource.data.doacaoAtualId)
                        ).data.status == 'reaberta'
                        && getAfter(
                          /databases/$(database)/documents/doacoes/$(resource.data.doacaoAtualId)
                        ).data.dataReabertura == request.time
                      )

                      ||

                      (
                        resource.data.status == 'concluida'
                        && resource.data.usuarioEscolhidoId is string
                        && resource.data.dataConclusao is timestamp
                        && !resource.data.keys().hasAny(['doacaoAtualId'])
                        && request.resource.data.status == 'ativa'
                        && !request.resource.data.keys().hasAny([
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade',
                          'dataConclusao',
                          'doacaoAtualId'
                        ])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId',
                          'usuarioEscolhidoNome',
                          'usuarioEscolhidoCidade',
                          'dataConclusao'
                        ])
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.usuarioId == request.auth.uid;
    }

    match /publicacoes/{publicacaoId}/interesses/{usuarioId} {
      allow get: if request.auth != null
                    && (
                      request.auth.uid == usuarioId
                      || (
                        exists(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        ).data.usuarioId == request.auth.uid
                      )
                    );

      allow list: if request.auth != null
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    ).data.usuarioId == request.auth.uid;

      allow create: if request.auth != null
                    && request.auth.uid == usuarioId
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    ).data.status == 'ativa'
                    && get(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    ).data.usuarioId != request.auth.uid
                    && exists(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    )
                    && get(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    ).data.nome is string
                    && request.resource.data.keys().hasOnly([
                      'usuarioId',
                      'nomeUsuario',
                      'cidade',
                      'mensagem',
                      'dataCriacao'
                    ])
                    && request.resource.data.keys().hasAll([
                      'usuarioId',
                      'nomeUsuario',
                      'cidade',
                      'mensagem',
                      'dataCriacao'
                    ])
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.nomeUsuario is string
                    && request.resource.data.nomeUsuario ==
                       get(
                         /databases/$(database)/documents/usuarios/$(request.auth.uid)
                       ).data.nome
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() > 0
                    && request.resource.data.mensagem.size() <= 250
                    && request.resource.data.dataCriacao == request.time
                    && request.resource.data.cidade is string
                    && request.resource.data.cidade.size() > 0
                    && get(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    ).data.cidade is string
                    && request.resource.data.cidade ==
                       get(
                         /databases/$(database)/documents/usuarios/$(request.auth.uid)
                       ).data.cidade;

      allow update: if false;

      allow delete: if request.auth != null
                    && (
                      request.auth.uid == usuarioId
                      || (
                        exists(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        ).data.usuarioId == request.auth.uid
                      )
                    );
    }

    match /conversas/{conversaId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'publicacaoId',
                      'tituloPublicacao',
                      'imagemPublicacao',
                      'doadorId',
                      'doadorNome',
                      'interessadoId',
                      'interessadoNome',
                      'participantes',
                      'dataCriacao',
                      'ultimaMensagem',
                      'ultimaMensagemRemetenteId',
                      'dataUltimaMensagem'
                    ])
                    && request.resource.data.keys().hasAll([
                      'publicacaoId',
                      'tituloPublicacao',
                      'imagemPublicacao',
                      'doadorId',
                      'doadorNome',
                      'interessadoId',
                      'interessadoNome',
                      'participantes',
                      'dataCriacao',
                      'ultimaMensagem',
                      'ultimaMensagemRemetenteId',
                      'dataUltimaMensagem'
                    ])
                    && request.resource.data.publicacaoId is string
                    && request.resource.data.tituloPublicacao is string
                    && (
                      request.resource.data.imagemPublicacao == null
                      || request.resource.data.imagemPublicacao is string
                    )
                    && request.resource.data.doadorId is string
                    && request.resource.data.interessadoId is string
                    && request.resource.data.doadorId != request.resource.data.interessadoId
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.resource.data.doadorId in request.resource.data.participantes
                    && request.resource.data.interessadoId in request.resource.data.participantes
                    && request.auth.uid in request.resource.data.participantes
                    && conversaId == request.resource.data.publicacaoId + '_' + request.resource.data.interessadoId
                    && request.resource.data.dataCriacao == request.time
                    && request.resource.data.ultimaMensagem == ''
                    && request.resource.data.ultimaMensagemRemetenteId == null
                    && request.resource.data.dataUltimaMensagem == null
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    ).data.usuarioId == request.resource.data.doadorId
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    ).data.titulo == request.resource.data.tituloPublicacao
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    ).data.nomeDoador == request.resource.data.doadorNome
                    && (
                      request.resource.data.imagemPublicacao == null
                      || (
                        get(
                          /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                        ).data.imagens is list
                        && request.resource.data.imagemPublicacao in get(
                          /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                        ).data.imagens
                      )
                    )
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.resource.data.interessadoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.resource.data.interessadoId)
                    ).data.usuarioId == request.resource.data.interessadoId
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.resource.data.interessadoId)
                    ).data.nomeUsuario == request.resource.data.interessadoNome;

      allow get: if request.auth != null
                    && (
                      !exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      || request.auth.uid in resource.data.participantes
                    );

      allow list: if request.auth != null
                    && request.auth.uid in resource.data.participantes;


      allow update: if request.auth != null
                    && (
                      (
                        request.auth.uid in resource.data.participantes
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'ultimaMensagem',
                          'ultimaMensagemRemetenteId',
                          'dataUltimaMensagem'
                        ])
                        && request.resource.data.ultimaMensagem is string
                        && request.resource.data.ultimaMensagem.size() > 0
                        && request.resource.data.ultimaMensagem.size() <= 1000
                        && request.resource.data.ultimaMensagemRemetenteId == request.auth.uid
                        && request.resource.data.dataUltimaMensagem == request.time
                      )

                      ||

                      (
                        request.auth.uid == resource.data.doadorId
                        && request.auth.uid in resource.data.participantes
                        && resource.data.publicacaoId is string
                        && exists(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        ).data.usuarioId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'tituloPublicacao',
                          'imagemPublicacao'
                        ])
                        && request.resource.data.tituloPublicacao is string
                        && request.resource.data.tituloPublicacao ==
                          get(
                            /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                          ).data.titulo
                        && get(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        ).data.imagens is list
                        && get(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        ).data.imagens.size() > 0
                        && request.resource.data.imagemPublicacao is string
                        && request.resource.data.imagemPublicacao ==
                          get(
                            /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                          ).data.imagens[0]
                      )
                    );

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.doadorId;

      match /mensagens/{mensagemId} {
        allow read: if request.auth != null
                      && exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      && request.auth.uid in get(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      ).data.participantes;

        allow create: if request.auth != null
                      && exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      && request.auth.uid in get(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      ).data.participantes
                      && request.resource.data.keys().hasOnly([
                        'remetenteId',
                        'texto',
                        'dataEnvio'
                      ])
                      && request.resource.data.keys().hasAll([
                        'remetenteId',
                        'texto',
                        'dataEnvio'
                      ])
                      && request.resource.data.remetenteId == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 1000
                      && request.resource.data.dataEnvio == request.time;

        allow update: if false;

        allow delete: if request.auth != null
                      && exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      && request.auth.uid == get(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      ).data.doadorId;
      }
    }


    match /doacoes/{doacaoId} {
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly([
                        'publicacaoId',
                        'tituloPublicacao',
                        'imagemPublicacao',
                        'doadorId',
                        'doadorNome',
                        'beneficiarioId',
                        'beneficiarioNome',
                        'beneficiarioCidade',
                        'participantes',
                        'dataConclusao',
                        'status'
                      ])
                      && request.resource.data.keys().hasAll([
                        'publicacaoId',
                        'tituloPublicacao',
                        'imagemPublicacao',
                        'doadorId',
                        'doadorNome',
                        'beneficiarioId',
                        'beneficiarioNome',
                        'beneficiarioCidade',
                        'participantes',
                        'dataConclusao',
                        'status'
                      ])
                      && request.resource.data.publicacaoId is string
                      && request.resource.data.publicacaoId.size() > 0
                      && request.resource.data.tituloPublicacao is string
                      && request.resource.data.tituloPublicacao.size() > 0
                      && (
                        request.resource.data.imagemPublicacao == null
                        || request.resource.data.imagemPublicacao is string
                      )
                      && request.resource.data.doadorId == request.auth.uid
                      && request.resource.data.doadorNome is string
                      && request.resource.data.beneficiarioId is string
                      && request.resource.data.beneficiarioId != request.auth.uid
                      && request.resource.data.beneficiarioNome is string
                      && request.resource.data.beneficiarioCidade is string
                      && request.resource.data.participantes is list
                      && request.resource.data.participantes.size() == 2
                      && request.resource.data.doadorId in request.resource.data.participantes
                      && request.resource.data.beneficiarioId in request.resource.data.participantes
                      && request.resource.data.dataConclusao == request.time
                      && request.resource.data.status == 'concluida'
                      && exists(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      )
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.usuarioId == request.auth.uid
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.status == 'concluida'
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.doacaoAtualId == doacaoId
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.usuarioEscolhidoId == request.resource.data.beneficiarioId
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.usuarioEscolhidoNome == request.resource.data.beneficiarioNome
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.usuarioEscolhidoCidade == request.resource.data.beneficiarioCidade
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.titulo == request.resource.data.tituloPublicacao
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.nomeDoador == request.resource.data.doadorNome
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.dataConclusao == request.time
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                      ).data.imagens is list
                      && (
                        (
                          request.resource.data.imagemPublicacao == null
                          && getAfter(
                            /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                          ).data.imagens.size() == 0
                        )
                        ||
                        (
                          request.resource.data.imagemPublicacao is string
                          && getAfter(
                            /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                          ).data.imagens.size() > 0
                          && request.resource.data.imagemPublicacao == getAfter(
                            /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                          ).data.imagens[0]
                        )
                      );

        allow get, list: if request.auth != null
                      && request.auth.uid in resource.data.participantes;

        allow update: if request.auth != null
                      && request.auth.uid == resource.data.doadorId
                      && resource.data.status == 'concluida'
                      && !resource.data.keys().hasAny(['dataReabertura'])
                      && request.resource.data.status == 'reaberta'
                      && request.resource.data.dataReabertura == request.time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status',
                        'dataReabertura'
                      ])
                      && exists(
                        /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                      )
                      && get(
                        /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                      ).data.status == 'concluida'
                      && get(
                        /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                      ).data.doacaoAtualId == doacaoId
                      && getAfter(
                        /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                      ).data.status == 'ativa'
                      && !getAfter(
                        /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                      ).data.keys().hasAny([
                        'usuarioEscolhidoId',
                        'usuarioEscolhidoNome',
                        'usuarioEscolhidoCidade',
                        'dataConclusao',
                        'doacaoAtualId'
                      ]);

        allow delete: if false;
    }

    match /denuncias/{denunciaId} {
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly([
                        'denuncianteId',
                        'denunciadoId',
                        'tipo',
                        'publicacaoId',
                        'tituloPublicacao',
                        'conversaId',
                        'motivo',
                        'descricao',
                        'dataCriacao',
                        'status'
                      ])
                      && request.resource.data.keys().hasAll([
                        'denuncianteId',
                        'denunciadoId',
                        'tipo',
                        'publicacaoId',
                        'tituloPublicacao',
                        'conversaId',
                        'motivo',
                        'descricao',
                        'dataCriacao',
                        'status'
                      ])
                      && request.resource.data.denuncianteId == request.auth.uid
                      && request.resource.data.denunciadoId is string
                      && request.resource.data.denunciadoId != request.auth.uid
                      && request.resource.data.publicacaoId is string
                      && request.resource.data.publicacaoId.size() > 0
                      && request.resource.data.tituloPublicacao is string
                      && request.resource.data.tituloPublicacao.size() > 0
                      && request.resource.data.motivo is string
                      && request.resource.data.descricao is string
                      && request.resource.data.descricao.size() <= 500
                      && request.resource.data.dataCriacao == request.time
                      && request.resource.data.status == 'pendente'
                      && (
                        (
                          request.resource.data.tipo == 'publicacao'
                          && request.resource.data.conversaId == null
                          && request.resource.data.motivo in [
                            'Item proibido ou perigoso',
                            'Cobrança de valores ou tentativa de venda',
                            'Conduta inadequada ou ofensiva',
                            'Informações falsas ou fotos que não correspondem',
                            'Spam ou conteúdo repetido',
                            'Outro'
                          ]
                          && exists(
                            /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                          )
                          && get(
                            /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                          ).data.usuarioId == request.resource.data.denunciadoId
                          && get(
                            /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                          ).data.titulo == request.resource.data.tituloPublicacao
                          && (
                            get(
                              /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                            ).data.status == 'ativa'
                            || (
                              get(
                                /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                              ).data.keys().hasAny(['usuarioEscolhidoId'])
                              && get(
                                /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                              ).data.usuarioEscolhidoId == request.auth.uid
                            )
                            || exists(
                              /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.auth.uid)
                            )
                          )
                        )
                        ||
                        (
                          request.resource.data.tipo == 'usuario'
                          && request.resource.data.conversaId is string
                          && request.resource.data.motivo in [
                            'Item proibido ou perigoso',
                            'Cobrança de valores ou tentativa de venda',
                            'Conduta inadequada ou ofensiva',
                            'Informações falsas ou fotos que não correspondem',
                            'Spam ou conteúdo repetido',
                            'Outro'
                          ]
                          && exists(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          )
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.doadorId is string
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.interessadoId is string
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.participantes is list
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.participantes.size() == 2
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.doadorId != get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.interessadoId
                          && request.auth.uid in get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.participantes
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.doadorId in get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.participantes
                          && get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.interessadoId in get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.participantes
                          && (
                            (
                              request.auth.uid == get(
                                /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                              ).data.doadorId
                              && request.resource.data.denunciadoId == get(
                                /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                              ).data.interessadoId
                            )
                            ||
                            (
                              request.auth.uid == get(
                                /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                              ).data.interessadoId
                              && request.resource.data.denunciadoId == get(
                                /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                              ).data.doadorId
                            )
                          )
                          && request.resource.data.publicacaoId == get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.publicacaoId
                          && request.resource.data.tituloPublicacao == get(
                            /databases/$(database)/documents/conversas/$(request.resource.data.conversaId)
                          ).data.tituloPublicacao
                        )
                      );

        allow read, update, delete: if false;
    }
  }
}