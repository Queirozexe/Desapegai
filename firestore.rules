rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.cidade is string
                    && request.resource.data.cidade.size() > 0
                    && request.resource.data.sobreMim is string;

      allow get: if request.auth != null
                 && request.auth.uid == userId;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'nome',
                      'email',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'nome',
                      'cidade',
                      'sobreMim'
                    ])
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.cidade is string
                    && request.resource.data.cidade.size() > 0
                    && request.resource.data.sobreMim is string;

      allow list, delete: if false;
    }

    match /publicacoes/{publicacaoId} {
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid
                    && exists(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    )
                    && request.resource.data.nomeDoador is string
                    && request.resource.data.nomeDoador ==
                      get(
                        /databases/$(database)/documents/usuarios/$(request.auth.uid)
                      ).data.nome
                    && request.resource.data.keys().hasOnly([
                      'usuarioId',
                      'nomeDoador',
                      'titulo',
                      'descricao',
                      'categoria',
                      'estadoConservacao',
                      'cidade',
                      'dataCriacao',
                      'status',
                      'imagens'
                    ])
                    && request.resource.data.keys().hasAll([
                      'usuarioId',
                      'nomeDoador',
                      'titulo',
                      'descricao',
                      'categoria',
                      'estadoConservacao',
                      'cidade',
                      'dataCriacao',
                      'status',
                      'imagens'
                    ])
                    && request.resource.data.titulo is string
                    && request.resource.data.descricao is string
                    && request.resource.data.categoria is string
                    && request.resource.data.estadoConservacao is string
                    && request.resource.data.cidade is string
                    && request.resource.data.dataCriacao is timestamp
                    && request.resource.data.status == 'ativa'
                    && request.resource.data.imagens is list
                    && request.resource.data.imagens.size() <= 3;

      allow get: if request.auth != null
                    && (
                      resource.data.status == 'ativa'
                      || resource.data.usuarioId == request.auth.uid
                      || (
                        resource.data.keys().hasAny(['usuarioEscolhidoId'])
                        && resource.data.usuarioEscolhidoId == request.auth.uid
                      )
                      || exists(
                        /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.auth.uid)
                      )
                    );

      allow list: if request.auth != null
                    && (
                      resource.data.status == 'ativa'
                      || resource.data.usuarioId == request.auth.uid
                      || (
                        resource.data.keys().hasAny(['usuarioEscolhidoId'])
                        && resource.data.usuarioEscolhidoId == request.auth.uid
                      )
                    );

      allow update: if request.auth != null
                    && resource.data.usuarioId == request.auth.uid
                    && (

                      (
                        request.resource.data.usuarioId == resource.data.usuarioId
                        && request.resource.data.dataCriacao == resource.data.dataCriacao
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'titulo',
                          'descricao',
                          'categoria',
                          'estadoConservacao',
                          'cidade',
                          'imagens'
                        ])
                        && request.resource.data.titulo is string
                        && request.resource.data.descricao is string
                        && request.resource.data.categoria is string
                        && request.resource.data.estadoConservacao is string
                        && request.resource.data.cidade is string
                        && request.resource.data.imagens is list
                        && request.resource.data.imagens.size() <= 3
                      )

                      ||

                      (
                        resource.data.status == 'ativa'
                        && !resource.data.keys().hasAny(['usuarioEscolhidoId'])
                        && request.resource.data.status == 'em_andamento'
                        && request.resource.data.usuarioEscolhidoId is string
                        && request.resource.data.usuarioEscolhidoId != request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId'
                        ])
                        && exists(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.resource.data.usuarioEscolhidoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)/interesses/$(request.resource.data.usuarioEscolhidoId)
                        ).data.usuarioId == request.resource.data.usuarioEscolhidoId
                      )

                      ||

                      (
                        resource.data.status == 'em_andamento'
                        && resource.data.usuarioEscolhidoId is string
                        && request.resource.data.status == 'ativa'
                        && !request.resource.data.keys().hasAny([
                          'usuarioEscolhidoId',
                          'dataConclusao'
                        ])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId'
                        ])
                      )

                      ||

                      (
                        resource.data.status == 'em_andamento'
                        && resource.data.usuarioEscolhidoId is string
                        && !resource.data.keys().hasAny(['dataConclusao'])
                        && request.resource.data.status == 'concluida'
                        && request.resource.data.usuarioEscolhidoId == resource.data.usuarioEscolhidoId
                        && request.resource.data.dataConclusao == request.time
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'dataConclusao'
                        ])
                      )

                      ||

                      (
                        resource.data.status == 'concluida'
                        && resource.data.keys().hasAll([
                          'usuarioEscolhidoId',
                          'dataConclusao'
                        ])
                        && resource.data.usuarioEscolhidoId is string
                        && resource.data.dataConclusao is timestamp
                        && request.resource.data.status == 'ativa'
                        && !request.resource.data.keys().hasAny([
                          'usuarioEscolhidoId',
                          'dataConclusao'
                        ])
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status',
                          'usuarioEscolhidoId',
                          'dataConclusao'
                        ])
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.usuarioId == request.auth.uid;
    }

    match /publicacoes/{publicacaoId}/interesses/{usuarioId} {
      allow get: if request.auth != null
                    && (
                      request.auth.uid == usuarioId
                      || (
                        exists(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        ).data.usuarioId == request.auth.uid
                      )
                    );

      allow list: if request.auth != null
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    ).data.usuarioId == request.auth.uid;

      allow create: if request.auth != null
                    && request.auth.uid == usuarioId
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    ).data.status == 'ativa'
                    && get(
                      /databases/$(database)/documents/publicacoes/$(publicacaoId)
                    ).data.usuarioId != request.auth.uid
                    && exists(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    )
                    && get(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    ).data.nome is string
                    && request.resource.data.keys().hasOnly([
                      'usuarioId',
                      'nomeUsuario',
                      'cidade',
                      'mensagem',
                      'dataCriacao'
                    ])
                    && request.resource.data.keys().hasAll([
                      'usuarioId',
                      'nomeUsuario',
                      'cidade',
                      'mensagem',
                      'dataCriacao'
                    ])
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.nomeUsuario is string
                    && request.resource.data.nomeUsuario ==
                       get(
                         /databases/$(database)/documents/usuarios/$(request.auth.uid)
                       ).data.nome
                    && request.resource.data.mensagem is string
                    && request.resource.data.mensagem.size() > 0
                    && request.resource.data.mensagem.size() <= 250
                    && request.resource.data.dataCriacao == request.time
                    && request.resource.data.cidade is string
                    && request.resource.data.cidade.size() > 0
                    && get(
                      /databases/$(database)/documents/usuarios/$(request.auth.uid)
                    ).data.cidade is string
                    && request.resource.data.cidade ==
                       get(
                         /databases/$(database)/documents/usuarios/$(request.auth.uid)
                       ).data.cidade;

      allow update: if false;

      allow delete: if request.auth != null
                    && (
                      request.auth.uid == usuarioId
                      || (
                        exists(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(publicacaoId)
                        ).data.usuarioId == request.auth.uid
                      )
                    );
    }

    match /conversas/{conversaId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'publicacaoId',
                      'tituloPublicacao',
                      'imagemPublicacao',
                      'doadorId',
                      'doadorNome',
                      'interessadoId',
                      'interessadoNome',
                      'participantes',
                      'dataCriacao',
                      'ultimaMensagem',
                      'ultimaMensagemRemetenteId',
                      'dataUltimaMensagem'
                    ])
                    && request.resource.data.keys().hasAll([
                      'publicacaoId',
                      'tituloPublicacao',
                      'imagemPublicacao',
                      'doadorId',
                      'doadorNome',
                      'interessadoId',
                      'interessadoNome',
                      'participantes',
                      'dataCriacao',
                      'ultimaMensagem',
                      'ultimaMensagemRemetenteId',
                      'dataUltimaMensagem'
                    ])
                    && request.resource.data.publicacaoId is string
                    && request.resource.data.tituloPublicacao is string
                    && (
                      request.resource.data.imagemPublicacao == null
                      || request.resource.data.imagemPublicacao is string
                    )
                    && request.resource.data.doadorId is string
                    && request.resource.data.interessadoId is string
                    && request.resource.data.doadorId != request.resource.data.interessadoId
                    && request.resource.data.participantes is list
                    && request.resource.data.participantes.size() == 2
                    && request.resource.data.doadorId in request.resource.data.participantes
                    && request.resource.data.interessadoId in request.resource.data.participantes
                    && request.auth.uid in request.resource.data.participantes
                    && conversaId == request.resource.data.publicacaoId + '_' + request.resource.data.interessadoId
                    && request.resource.data.dataCriacao == request.time
                    && request.resource.data.ultimaMensagem == ''
                    && request.resource.data.ultimaMensagemRemetenteId == null
                    && request.resource.data.dataUltimaMensagem == null
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    ).data.usuarioId == request.resource.data.doadorId
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    ).data.titulo == request.resource.data.tituloPublicacao
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                    ).data.nomeDoador == request.resource.data.doadorNome
                    && (
                      request.resource.data.imagemPublicacao == null
                      || (
                        get(
                          /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                        ).data.imagens is list
                        && request.resource.data.imagemPublicacao in get(
                          /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)
                        ).data.imagens
                      )
                    )
                    && exists(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.resource.data.interessadoId)
                    )
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.resource.data.interessadoId)
                    ).data.usuarioId == request.resource.data.interessadoId
                    && get(
                      /databases/$(database)/documents/publicacoes/$(request.resource.data.publicacaoId)/interesses/$(request.resource.data.interessadoId)
                    ).data.nomeUsuario == request.resource.data.interessadoNome;

      allow get: if request.auth != null
                    && (
                      !exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      || request.auth.uid in resource.data.participantes
                    );

      allow list: if request.auth != null
                    && request.auth.uid in resource.data.participantes;


      allow update: if request.auth != null
                    && (
                      (
                        request.auth.uid in resource.data.participantes
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'ultimaMensagem',
                          'ultimaMensagemRemetenteId',
                          'dataUltimaMensagem'
                        ])
                        && request.resource.data.ultimaMensagem is string
                        && request.resource.data.ultimaMensagem.size() > 0
                        && request.resource.data.ultimaMensagem.size() <= 1000
                        && request.resource.data.ultimaMensagemRemetenteId == request.auth.uid
                        && request.resource.data.dataUltimaMensagem == request.time
                      )

                      ||

                      (
                        request.auth.uid == resource.data.doadorId
                        && request.auth.uid in resource.data.participantes
                        && resource.data.publicacaoId is string
                        && exists(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        )
                        && get(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        ).data.usuarioId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'tituloPublicacao',
                          'imagemPublicacao'
                        ])
                        && request.resource.data.tituloPublicacao is string
                        && request.resource.data.tituloPublicacao ==
                          get(
                            /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                          ).data.titulo
                        && get(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        ).data.imagens is list
                        && get(
                          /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                        ).data.imagens.size() > 0
                        && request.resource.data.imagemPublicacao is string
                        && request.resource.data.imagemPublicacao ==
                          get(
                            /databases/$(database)/documents/publicacoes/$(resource.data.publicacaoId)
                          ).data.imagens[0]
                      )
                    );

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.doadorId;

      match /mensagens/{mensagemId} {
        allow read: if request.auth != null
                      && exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      && request.auth.uid in get(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      ).data.participantes;

        allow create: if request.auth != null
                      && exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      && request.auth.uid in get(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      ).data.participantes
                      && request.resource.data.keys().hasOnly([
                        'remetenteId',
                        'texto',
                        'dataEnvio'
                      ])
                      && request.resource.data.keys().hasAll([
                        'remetenteId',
                        'texto',
                        'dataEnvio'
                      ])
                      && request.resource.data.remetenteId == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 1000
                      && request.resource.data.dataEnvio == request.time;

        allow update: if false;

        allow delete: if request.auth != null
                      && exists(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      )
                      && request.auth.uid == get(
                        /databases/$(database)/documents/conversas/$(conversaId)
                      ).data.doadorId;
      }
    }
  }
}